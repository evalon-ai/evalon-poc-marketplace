{
  "name": "example-portable-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/portable-node-loader.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/portable-node-loader.js",
    "compile:darwin-arm64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-darwin-arm64 --outfile bin/portable-node-darwin-arm64",
    "compile:darwin-x64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-darwin-x64 --outfile bin/portable-node-darwin-x64",
    "compile:linux-arm64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-linux-arm64 --outfile bin/portable-node-linux-arm64",
    "compile:linux-x64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-linux-x64 --outfile bin/portable-node-linux-x64",
    "compile:windows-arm64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-windows-arm64 --outfile bin/portable-node-windows-arm64.exe",
    "compile:windows-x64": "bun build src/portable-node-loader.ts --compile --minify --target=bun-windows-x64 --outfile bin/portable-node-windows-x64.exe",
    "compile:all": "npm run compile:darwin-arm64 && npm run compile:darwin-x64 && npm run compile:linux-arm64 && npm run compile:linux-x64 && npm run compile:windows-arm64 && npm run compile:windows-x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.2"
  }
}
